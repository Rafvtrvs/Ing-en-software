# Desarrollo local (copiá a .env). Para nube: ver .env.production.example
VITE_API_URL=http://localhost:4000/api

# Mapbox — token público (pk.*) desde https://account.mapbox.com/access-tokens/
# Reiniciá npm run dev (o volvé a build) tras cambiarlo.
VITE_MAPBOX_TOKEN=

# Firebase Auth + FCM (proyecto camuslda). Ver docs/FIREBASE-AUTH-PUSH.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=camuslda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=camuslda
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
