# ===========================================
# Backend - Variables de Entorno
# ===========================================
# Copia este archivo como .env y ajusta los valores

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/camus_lda

# --- Servidor ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Autenticación ---
# En desarrollo puedes dejarlo así, en producción usa un secreto largo y aleatorio
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=8h

# Proveedor de auth: "local" (usuarios en BD) o "firebase"
AUTH_PROVIDER=local

# --- Servicios externos (opcionales en desarrollo) ---
# Todos usan "mock" por defecto en desarrollo

# Almacenamiento de archivos: "mock" | "local" | "s3"
STORAGE_PROVIDER=mock
STORAGE_LOCAL_DIR=./.storage

# Envío de correos: "mock" | "resend"
MAIL_PROVIDER=mock
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=Camus LDA <noreply@tudominio.cl>
# MAIL_OPS_TO=operaciones@camus.cl

# Push notifications: "mock" | "fcm"
PUSH_PROVIDER=mock
