// ============================================================
//  Prisma ORM  ->  Cloud SQL PostgreSQL (Transaccional)
//  Componente "Conexión BD" del diagrama de despliegue.
//  Refleja base_de_datos.postgresql.sql.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id          Int      @id @default(autoincrement()) @map("id_rol")
  nombre      String   @db.VarChar(100)
  descripcion String   @default("") @db.VarChar(255)
  estado      String   @default("Activo") @db.VarChar(20)
  esSistema   Boolean  @default(false) @map("es_sistema")
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("rol")
}

model Permiso {
  id       Int    @id @default(autoincrement()) @map("id_permiso")
  clave    String @unique @db.VarChar(100)
  etiqueta String @db.VarChar(150)
  modulo   String @db.VarChar(100)
  roles    RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  idRol     Int @map("id_rol")
  idPermiso Int @map("id_permiso")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [idPermiso], references: [id], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@map("rol_permiso")
}

model Usuario {
  id               Int       @id @default(autoincrement()) @map("id_usuario")
  nombre           String    @db.VarChar(100)
  correoElectronico String   @unique @map("correo_electronico") @db.VarChar(150)
  passwordHash     String    @default("") @map("password_hash") @db.VarChar(255)
  firebaseUid      String    @default("") @map("firebase_uid") @db.VarChar(128)
  telefono         String    @default("") @db.VarChar(20)
  // Foto de perfil (data URL o URL http) por usuario
  avatarUrl        String    @default("") @map("avatar_url") @db.Text
  idRol            Int?      @map("id_rol")
  estado           String    @default("Activo") @db.VarChar(20)
  ultimoAcceso     DateTime? @map("ultimo_acceso")
  rol              Rol?      @relation(fields: [idRol], references: [id])
  ordenes          OrdenTrabajo[]
  auditorias       BitacoraAuditoria[]
  dispositivosPush DispositivoPush[]

  @@map("usuario")
}

// Tokens FCM por dispositivo (push al admin)
model DispositivoPush {
  id        Int      @id @default(autoincrement()) @map("id_dispositivo")
  idUsuario Int      @map("id_usuario")
  fcmToken  String   @unique @map("fcm_token") @db.VarChar(512)
  platform  String   @default("web") @db.VarChar(40)
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  usuario   Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("dispositivo_push")
}

model Cliente {
  id          Int      @id @default(autoincrement()) @map("id_cliente")
  rut         String   @unique @db.VarChar(12)
  nombre      String   @db.VarChar(100)
  empresa     String   @default("") @db.VarChar(150)
  telefono    String   @default("") @db.VarChar(20)
  email       String   @default("") @db.VarChar(150)
  direccion   String   @default("") @db.VarChar(255)
  estado      String   @default("Activo") @db.VarChar(20)
  ultimaOrden String   @default("") @map("ultima_orden") @db.VarChar(20)
  creadoEn    DateTime @default(now()) @map("creado_en")
  ordenes     OrdenTrabajo[]
  facturas    Factura[]

  @@map("cliente")
}

model Maquinaria {
  id                Int       @id @default(autoincrement()) @map("id_maquinaria")
  patente           String?   @db.VarChar(20)
  marca             String?   @db.VarChar(50)
  estado            String    @default("Operativo") @db.VarChar(50)
  codigo            String    @default("") @db.VarChar(50)
  nombre            String    @default("") @db.VarChar(150)
  numeroSerie       String    @default("") @map("numero_serie") @db.VarChar(50)
  ubicacion         String    @default("") @db.VarChar(150)
  /// Ubicación original del usuario; se restaura al liberar de una OT
  ubicacionBase     String    @default("") @map("ubicacion_base") @db.VarChar(150)
  categoria         String    @default("") @db.VarChar(100)
  fechaCompra       DateTime? @map("fecha_compra") @db.Date
  ultimaMantencion  DateTime? @map("ultima_mantencion") @db.Date
  proximaMantencion DateTime? @map("proxima_mantencion") @db.Date
  asignadoA         String?   @map("asignado_a") @db.VarChar(100)
  usos              Utiliza[]
  ordenesAsignadas  OrdenTrabajo[]

  @@map("maquinaria")
}

model Proveedor {
  id            Int    @id @default(autoincrement()) @map("id_proveedor")
  nombre        String @db.VarChar(150)
  rut           String @default("") @db.VarChar(12)
  contacto      String @default("") @db.VarChar(100)
  telefono      String @default("") @db.VarChar(20)
  email         String @default("") @db.VarChar(150)
  direccion     String @default("") @db.VarChar(255)
  condicionPago String @default("") @map("condicion_pago") @db.VarChar(100)
  estado        String @default("Activo") @db.VarChar(20)
  insumos       Insumo[]

  @@map("proveedor")
}

model CategoriaInsumo {
  id          Int    @id @default(autoincrement()) @map("id_categoria")
  nombre      String @db.VarChar(100)
  descripcion String @default("") @db.VarChar(255)
  estado      String @default("Activa") @db.VarChar(20)
  insumos     Insumo[]

  @@map("categoria_insumo")
}

model Insumo {
  id            Int     @id @default(autoincrement()) @map("id_insumo")
  codigo        String  @default("") @db.VarChar(50)
  nombre        String  @db.VarChar(100)
  stockActual   Int     @default(0) @map("stock_actual")
  stockMinimo   Int     @default(0) @map("stock_minimo")
  unidad        String  @default("unidad") @db.VarChar(30)
  /// Costo unitario de adquisición (para cálculo de utilidad / COGS)
  costoUnitario Decimal @default(0) @map("costo_unitario") @db.Decimal(12, 2)
  estado        String  @default("Ok") @db.VarChar(20)
  idCategoria   Int?    @map("id_categoria")
  idProveedor   Int?    @map("id_proveedor")
  categoria     CategoriaInsumo? @relation(fields: [idCategoria], references: [id])
  proveedor     Proveedor?       @relation(fields: [idProveedor], references: [id])
  kitItems      KitItem[]
  consumos      Consume[]
  movimientos   MovimientoStock[]

  @@map("insumo")
}

/// Historial de entradas/salidas de inventario (persistente)
model MovimientoStock {
  id        Int      @id @default(autoincrement()) @map("id_movimiento")
  idInsumo  Int      @map("id_insumo")
  tipo      String   @db.VarChar(20)
  cantidad  Int
  detalle   String   @default("") @db.VarChar(255)
  usuario   String   @default("Sistema") @db.VarChar(120)
  idOt      String?  @map("id_ot") @db.VarChar(30)
  fecha     DateTime @default(now())
  insumo    Insumo   @relation(fields: [idInsumo], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([idInsumo])
  @@map("movimiento_stock")
}

model Kit {
  id          Int    @id @default(autoincrement()) @map("id_kit")
  nombre      String @db.VarChar(100)
  descripcion String @default("") @db.VarChar(255)
  estado      String @default("Activo") @db.VarChar(20)
  items       KitItem[]

  @@map("kit")
}

model KitItem {
  idKit    Int @map("id_kit")
  idInsumo Int @map("id_insumo")
  cantidad Int @default(1)
  kit      Kit    @relation(fields: [idKit], references: [id], onDelete: Cascade)
  insumo   Insumo @relation(fields: [idInsumo], references: [id])

  @@id([idKit, idInsumo])
  @@map("kit_item")
}

model OrdenTrabajo {
  id           String   @id @map("id_ot") @db.VarChar(30)
  fechaEmision DateTime @default(now()) @map("fecha_emision") @db.Date
  estado       String   @default("Pendiente") @db.VarChar(50)
  prioridad    String   @default("Media") @db.VarChar(20)
  servicio     String   @default("") @db.VarChar(150)
  categoria    String   @default("") @db.VarChar(100)
  direccion    String   @default("") @db.VarChar(255)
  latitud      Float?   @map("latitud")
  longitud     Float?   @map("longitud")
  fechaLimite  DateTime? @map("fecha_limite") @db.Date
  /// Fecha de inicio de trabajo (formulario OT)
  fechaInicio  DateTime? @map("fecha_inicio") @db.Date
  /// Fecha de término de trabajo (formulario OT)
  fechaTermino DateTime? @map("fecha_termino") @db.Date
  duracionHoras Float?  @map("duracion_horas")
  /// Código del camión/equipo asignado (p. ej. CAM-012)
  codigoCamion String?  @map("codigo_camion") @db.VarChar(50)
  idMaquinaria Int?     @map("id_maquinaria")
  /// Nombre de cliente capturado en formulario (aunque no exista en tabla cliente)
  nombreCliente String  @default("") @map("nombre_cliente") @db.VarChar(150)
  progreso     Int      @default(0)
  ordenVisual  Int      @default(0) @map("orden_visual")
  idCliente    Int?     @map("id_cliente")
  idOperador   Int?     @map("id_operador")
  cliente      Cliente? @relation(fields: [idCliente], references: [id])
  operador     Usuario? @relation(fields: [idOperador], references: [id])
  maquinaria   Maquinaria? @relation(fields: [idMaquinaria], references: [id])
  intervenciones Intervencion[]
  evidencias   EvidenciaMultimedia[]
  documentos   DocumentoOrden[]
  registros    RegistroFinanciero[]
  facturas     Factura[]
  usos         Utiliza[]
  consumos     Consume[]
  solicitudesModificacion SolicitudModificacion[]
  historialModificacion   HistorialModificacionOt[]
  historialReprogramacion HistorialReprogramacionOt[]

  @@map("orden_trabajo")
}

/// RF68 — solicitudes de modificación de OT
model SolicitudModificacion {
  id              Int       @id @default(autoincrement()) @map("id_solicitud")
  idOt            String    @map("id_ot") @db.VarChar(30)
  idOperador      String    @map("id_operador") @db.VarChar(80)
  nombreOperador  String    @map("nombre_operador") @db.VarChar(150)
  camposModificar String    @map("campos_modificar") @db.VarChar(255)
  motivo          String    @db.VarChar(500)
  /// Parche propuesto (JSON). No se aplica a la OT hasta aprobar.
  cambiosJson     String    @default("") @map("cambios_json") @db.Text
  estado          String    @default("Pendiente") @db.VarChar(20)
  solicitadoEn    DateTime  @default(now()) @map("solicitado_en")
  idRevisor       String?   @map("id_revisor") @db.VarChar(80)
  nombreRevisor   String?   @map("nombre_revisor") @db.VarChar(150)
  revisadoEn      DateTime? @map("revisado_en")
  motivoRechazo   String?   @map("motivo_rechazo") @db.VarChar(500)
  orden           OrdenTrabajo @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@index([idOt])
  @@index([estado])
  @@map("solicitud_modificacion")
}

/// RF68 CDS 235 — historial de modificaciones aplicadas
model HistorialModificacionOt {
  id            Int      @id @default(autoincrement()) @map("id_historial")
  idOt          String   @map("id_ot") @db.VarChar(30)
  campo         String   @db.VarChar(80)
  etiqueta      String   @db.VarChar(120)
  valorAnterior String   @map("valor_anterior") @db.VarChar(500)
  valorNuevo    String   @map("valor_nuevo") @db.VarChar(500)
  idUsuario     String   @map("id_usuario") @db.VarChar(80)
  nombreUsuario String   @map("nombre_usuario") @db.VarChar(150)
  cambiadoEn    DateTime @default(now()) @map("cambiado_en")
  orden         OrdenTrabajo @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@index([idOt])
  @@map("historial_modificacion_ot")
}

/// RF66 CDS 229 — historial de reprogramaciones de fecha de ejecución
model HistorialReprogramacionOt {
  id            Int      @id @default(autoincrement()) @map("id_reprogramacion")
  idOt          String   @map("id_ot") @db.VarChar(30)
  fechaAnterior String   @map("fecha_anterior") @db.VarChar(40)
  fechaNueva    String   @map("fecha_nueva") @db.VarChar(40)
  idUsuario     String   @map("id_usuario") @db.VarChar(80)
  nombreUsuario String   @map("nombre_usuario") @db.VarChar(150)
  cambiadoEn    DateTime @default(now()) @map("cambiado_en")
  orden         OrdenTrabajo @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@index([idOt])
  @@index([cambiadoEn])
  @@map("historial_reprogramacion_ot")
}

/// RF-40..42 — documentos / contratos / reportes versionados por OT
model DocumentoOrden {
  id             Int      @id @default(autoincrement()) @map("id_documento")
  titulo         String   @db.VarChar(150)
  tipo           String   @default("general") @db.VarChar(30)
  versionActual  Int      @default(1) @map("version_actual")
  nombreArchivo  String   @map("nombre_archivo") @db.VarChar(255)
  mimeType       String   @default("application/pdf") @map("mime_type") @db.VarChar(100)
  tamanioBytes   Int      @default(0) @map("tamanio_bytes")
  urlArchivo     String   @map("url_archivo") @db.VarChar(500)
  subidoPor      String?  @map("subido_por") @db.VarChar(120)
  nota           String?  @db.VarChar(255)
  fechaCarga     DateTime @default(now()) @map("fecha_carga")
  idOt           String?  @map("id_ot") @db.VarChar(30)
  orden          OrdenTrabajo? @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@index([idOt])
  @@map("documento_orden")
}

model Intervencion {
  id      Int    @id @default(autoincrement()) @map("id_intervencion")
  detalle String? @db.VarChar(255)
  idOt    String? @map("id_ot") @db.VarChar(30)
  orden   OrdenTrabajo? @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@map("intervencion")
}

model BitacoraAuditoria {
  id            BigInt   @id @default(autoincrement()) @map("id_log")
  moduloAfectado String? @map("modulo_afectado") @db.VarChar(100)
  accion        String?  @db.VarChar(100)
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  idUsuario     Int?     @map("id_usuario")
  fechaHora     DateTime @default(now()) @map("fecha_hora")
  usuario       Usuario? @relation(fields: [idUsuario], references: [id])

  @@map("bitacora_auditoria")
}

model EvidenciaMultimedia {
  id            Int      @id @default(autoincrement()) @map("id_evidencia")
  tipoArchivo   String?  @map("tipo_archivo") @db.VarChar(50)
  version       Int      @default(1)
  rutaArchivoUrl String? @map("ruta_archivo_url") @db.VarChar(255)
  capaDibujoJson String? @map("capa_dibujo_json")
  fechaCarga    DateTime @default(now()) @map("fecha_carga")
  idOt          String?  @map("id_ot") @db.VarChar(30)
  orden         OrdenTrabajo? @relation(fields: [idOt], references: [id], onDelete: Cascade)

  @@map("evidencia_multimedia")
}

model RegistroFinanciero {
  id              Int     @id @default(autoincrement()) @map("id_registro")
  estimacionCosto Decimal @default(0) @map("estimacion_costo") @db.Decimal(12, 2)
  estadoPago      String  @default("Pendiente") @map("estado_pago") @db.VarChar(50)
  iva             Decimal @default(0) @db.Decimal(12, 2)
  idOt            String? @map("id_ot") @db.VarChar(30)
  orden           OrdenTrabajo? @relation(fields: [idOt], references: [id])

  @@map("registro_financiero")
}

model Factura {
  id               Int      @id @default(autoincrement()) @map("id_factura")
  numero           String   @unique @db.VarChar(40)
  idCliente        Int?     @map("id_cliente")
  idOt             String?  @map("id_ot") @db.VarChar(30)
  fechaEmision     DateTime @default(now()) @map("fecha_emision") @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  monto            Decimal  @default(0) @db.Decimal(12, 2)
  estado           String   @default("Emitida") @db.VarChar(20)
  metodoPago       String?  @map("metodo_pago") @db.VarChar(30)
  pagadaEn         DateTime? @map("pagada_en") @db.Date
  notas            String?
  cliente          Cliente? @relation(fields: [idCliente], references: [id])
  orden            OrdenTrabajo? @relation(fields: [idOt], references: [id])
  pagos            Pago[]

  @@map("factura")
}

model Pago {
  id        Int      @id @default(autoincrement()) @map("id_pago")
  idFactura Int?     @map("id_factura")
  monto     Decimal  @default(0) @db.Decimal(12, 2)
  metodo    String?  @db.VarChar(30)
  fecha     DateTime @default(now()) @db.Date
  factura   Factura? @relation(fields: [idFactura], references: [id])

  @@map("pago")
}

model Utiliza {
  idOt         String @map("id_ot") @db.VarChar(30)
  idMaquinaria Int    @map("id_maquinaria")
  horasUso     Int    @default(0) @map("horas_uso")
  fechaUso     DateTime? @map("fecha_uso") @db.Date
  orden        OrdenTrabajo @relation(fields: [idOt], references: [id], onDelete: Cascade)
  maquinaria   Maquinaria   @relation(fields: [idMaquinaria], references: [id])

  @@id([idOt, idMaquinaria])
  @@map("utiliza")
}

model Consume {
  idOt              String  @map("id_ot") @db.VarChar(30)
  idInsumo          Int     @map("id_insumo")
  cantidadConsumida Int     @default(0) @map("cantidad_consumida")
  costoTotal        Decimal @default(0) @map("costo_total") @db.Decimal(12, 2)
  orden             OrdenTrabajo @relation(fields: [idOt], references: [id], onDelete: Cascade)
  insumo            Insumo       @relation(fields: [idInsumo], references: [id])

  @@id([idOt, idInsumo])
  @@map("consume")
}

// RF16: tarifas unitarias usadas para estimar costos (insumos, maquinaria, combustible, personal)
model TarifaCosto {
  id            Int      @id @default(autoincrement()) @map("id_tarifa")
  tipo          String   @db.VarChar(20)
  nombre        String   @db.VarChar(120)
  unidad        String   @default("unidad") @db.VarChar(30)
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(12, 2)

  @@map("tarifa_costo")
}

// RF16: estimación de costos guardada (detalle como JSON serializado)
model Estimacion {
  id            Int      @id @default(autoincrement()) @map("id_estimacion")
  descripcion   String   @default("") @db.VarChar(200)
  subtotal      Decimal  @db.Decimal(12, 2)
  tasaIva       Decimal  @map("tasa_iva") @db.Decimal(5, 2)
  iva           Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  detalle       String   @db.Text
  idUsuario     Int?     @map("id_usuario")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  @@map("estimacion")
}
