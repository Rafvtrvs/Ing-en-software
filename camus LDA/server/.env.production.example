# ============================================================
#  Backend — variables para la NUBE
#  Configurá estas en el panel del hosting (Railway, Render, etc.)
#  o en un .env del servidor. NUNCA subas secretos al repo.
# ============================================================

NODE_ENV=production
PORT=4000

# Postgres gestionado (Neon, Supabase, RDS, Cloud SQL, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/camus_lda?schema=public&sslmode=require"

AUTH_PROVIDER=firebase
# JSON service account (una línea). Ver docs/FIREBASE-AUTH-PUSH.md
FIREBASE_SERVICE_ACCOUNT_JSON=
# Obligatorio en producción: secreto largo y aleatorio (no uses el de desarrollo)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen(es) del frontend publicado. Varios: separados por coma.
# Ejemplo: https://camuslda.web.app
CORS_ORIGIN=https://camuslda.web.app

STORAGE_PROVIDER=mock
MAIL_PROVIDER=mock
PUSH_PROVIDER=fcm
STORAGE_LOCAL_DIR=./.storage
