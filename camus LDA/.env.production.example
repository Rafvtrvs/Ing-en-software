# ============================================================
#  Frontend — variables para build/deploy en la NUBE
#  Copiá a .env.production (o configurá en el hosting) ANTES de
#  `npm run build`. Vite las incrusta en el bundle en compile-time.
# ============================================================

# URL pública de la API (HTTPS, con /api al final)
VITE_API_URL=https://api.tudominio.com/api

# Token público Mapbox (pk.*) — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.tu_token_mapbox
